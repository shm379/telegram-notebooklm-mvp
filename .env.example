APP_NAME=Telegram Notebook
DATA_DIR=data
DB_PATH=data/store.db
MEDIA_DIR=data/media

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_NAME=telegram-notebook
# Get this from @BotFather. NEVER commit a real token to the repo.
TELEGRAM_BOT_TOKEN=

OPENAI_API_KEY=
GEMINI_API_KEY=
TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-flash-latest
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

CHUNK_SIZE=900
CHUNK_OVERLAP=120
DEFAULT_RESULT_LIMIT=8

# Audio Overview / podcast (/podcast). Needs the optional extra: pip install ".[podcast]"
# TTS engine: "edge" (free, no key — default), "openai", "gemini", or "elevenlabs".
PODCAST_TTS_MODEL=edge
# Optional override for the LLM that writes the conversation (e.g. gpt-4o-mini).
# Leave blank to use Podcastfy's default (Gemini when GEMINI_API_KEY is set).
PODCAST_LLM_MODEL=

# Telegram-Toolset: run a deleted-message watcher for the web's server account.
# When 1/true, the web app keeps a live client on TELEGRAM_SESSION_STRING that
# caches incoming messages and recovers deleted ones (visible at /api/deleted).
# Only messages received after it starts can be recovered. Default off.
WEB_WATCH_DELETED=

# Security
# Token required to call the web API (/api/*) from non-local clients. When set, send it
# as "Authorization: Bearer <token>" or "X-API-Token: <token>". When empty, the API only
# accepts loopback (localhost) requests. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_TOKEN=
# Master key used to encrypt secrets (Telegram session strings, API hashes, API keys)
# at rest in the database. When empty, secrets are stored UNENCRYPTED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this stable: changing it makes previously stored secrets unreadable (re-login needed).
SECRETS_KEY=

# Vertex AI Search (leave blank to use local keyword/cosine search only)
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_INDEX_ID=
VERTEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=

# Telegram Proxy (If needed for connection issues)
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_TYPE=socks5
